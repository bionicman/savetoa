[Unit]
Description=SaveToA backup target %i
Documentation=https://github.com/bionicman/savetoa
After=network-online.target
Wants=network-online.target
OnSuccess=savetoa-prune@%i.service

[Service]
Type=oneshot
User=savetoa
Group=savetoa
ExecStart=/usr/bin/savetoa --config /etc/savetoa/config.yml run %i
ConfigurationDirectory=savetoa
StateDirectory=savetoa
RuntimeDirectory=savetoa
ConfigurationDirectoryMode=0750
StateDirectoryMode=0770
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
UMask=0007

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/savetoa
ReadWritePaths=/var/backups/savetoa
InaccessiblePaths=/etc/savetoa/maintenance-credentials.d

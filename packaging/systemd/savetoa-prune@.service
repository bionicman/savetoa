[Unit]
Description=Apply SaveToA retention for target %i
Documentation=https://github.com/bionicman/savetoa
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=savetoa-maintenance
Group=savetoa
ExecStart=/usr/bin/savetoa --config /etc/savetoa/config.yml prune %i
UMask=0007

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/savetoa
ReadWritePaths=/var/backups/savetoa /var/lib/savetoa/spool /run/savetoa
InaccessiblePaths=/etc/savetoa/credentials.d /etc/savetoa/recipients.d

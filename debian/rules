#!/usr/bin/make -f

export DH_VERBOSE = 1
export CGO_ENABLED = 0

%:
	dh $@

override_dh_auto_build:
	mkdir -p build
	go build -trimpath \
		-ldflags "-X github.com/bionicman/savetoa/internal/buildinfo.Version=$$(dpkg-parsechangelog -SVersion)" \
		-o build/savetoa ./cmd/savetoa

override_dh_auto_test:
	go test ./...

override_dh_auto_clean:
	rm -rf build
	dh_auto_clean

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

# dwz cannot process the compressed DWARF emitted by current Go toolchains.
override_dh_dwz:
